{
  "name": "dechord-frontend",
  "version": "1.0.0",
  "description": "DeChord music practice studio for desktop and web.",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "format": "prettier --write src tests e2e playwright.config.ts",
    "format:check": "prettier --check src tests e2e playwright.config.ts",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "keywords": [
    "music",
    "chords",
    "tauri",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@soundtouchjs/audio-worklet": "2.1.1",
    "@tauri-apps/api": "^2.11.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-grid-layout": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
